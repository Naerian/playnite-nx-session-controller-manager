<UserControl x:Class="ControllerSessionManager.Tester.Views.GamepadTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ControllerSessionManager.Tester.Converters"
             xmlns:controls="clr-namespace:ControllerSessionManager.Tester.Views.Controls"
             xmlns:layouts="clr-namespace:ControllerSessionManager.Tester.Views.ControllerLayouts"
             xmlns:views="clr-namespace:ControllerSessionManager.Tester.Views"
             TextElement.FontSize="14"
             TextElement.FontWeight="Normal"
             TextElement.Foreground="{DynamicResource TextBrush}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource TextColorDarker}" Opacity="0.58" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource TextColorDarker}" Opacity="0.28" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextColorDarker}" />
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource HighlightGlyphColor}" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#31C48D" />
        <SolidColorBrush x:Key="ActivePillTextBrush" Color="#07130F" />
        <SolidColorBrush x:Key="PillIdleTextBrush" Color="{DynamicResource TextColor}" />
        <SolidColorBrush x:Key="IdleBrush" Color="{DynamicResource ControlBackgroundColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F7B955" />
        <SolidColorBrush x:Key="SwitchAccentBrush" Color="#E60012" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToBrushConverter x:Key="InputFillBrush"
                                         FalseBrush="{StaticResource IdleBrush}"
                                         TrueBrush="{StaticResource ActiveBrush}" />
        <converters:BoolToBrushConverter x:Key="PillTextBrush"
                                         FalseBrush="{StaticResource PillIdleTextBrush}"
                                         TrueBrush="{StaticResource ActivePillTextBrush}" />

        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="PageHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HintUnderLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="DashboardPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="DashboardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DashboardMetricTile" TargetType="Border" BasedOn="{StaticResource DashboardPanel}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="88" />
        </Style>

        <Style x:Key="SubtleVerticalSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Background" Value="{StaticResource LineBrush}" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="18,0" />
        </Style>

        <Style x:Key="SubtleHorizontalSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style x:Key="InputPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="LiveInputChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="CheckPill" TargetType="Border" BasedOn="{StaticResource InputPill}">
            <Setter Property="MinWidth" Value="92" />
        </Style>

        <Style x:Key="GuidedInputChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource ActivePillTextBrush}" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.86"
                                             To="1"
                                             Duration="0:0:0.85" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="RadarActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="TabGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SideNavigationTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False">
                            <Rectangle x:Name="NavigationFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <Rectangle x:Name="NavigationAccent" Width="4" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="16,12,16,12"
                                              TextElement.Foreground="{DynamicResource TextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="NavigationAccent" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNavigationTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SideNavigationTabItem}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="4"
                                    Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold"
                                               Margin="8,4,8,20" TextWrapping="Wrap" />
                                    <ComboBox DockPanel.Dock="Top"
                                              Margin="8,0,8,4"
                                              MaxDropDownHeight="320"
                                              Visibility="{Binding DataContext.IsControllerSelectorVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}"
                                              ItemsSource="{Binding DataContext.Controllers, RelativeSource={RelativeSource TemplatedParent}}"
                                              SelectedItem="{Binding DataContext.SelectedController, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              IsDropDownOpen="{Binding DataContext.IsControllerSelectorOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="Normal"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock DockPanel.Dock="Top"
                                               Text="{DynamicResource LOCCSM_Tester_SelectControllerHelp}"
                                               Style="{StaticResource HintText}"
                                               Margin="8,0,8,8"
                                               Visibility="{Binding DataContext.IsControllerSelectorVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource SubtleHorizontalSeparator}"
                                            Margin="8,4,8,12"
                                            Visibility="{Binding DataContext.HasController, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2" ClipToBounds="False">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ClipToBounds="False" />
                                <Border Background="{DynamicResource PopupBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="28"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Panel.ZIndex="10"
                                        Visibility="{Binding DataContext.IsNoControllerOverlayVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                MaxWidth="520">
                                        <TextBlock Text="{DynamicResource LOCCSM_NoControllers}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          TextElement.Foreground="{StaticResource PillIdleTextBrush}"
          TextElement.FontWeight="Normal">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl x:Name="TesterTabs"
                            Grid.Row="0"
                            Style="{StaticResource SideNavigationTabControl}"
                            Tag="{DynamicResource LOCCSM_TabTester}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            SelectionChanged="TesterTabsSelectionChanged"
                            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE7FC;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_TabTest}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,12,4,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="0" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.75*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource DashboardPanel}" Margin="0,0,12,0" VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_TabTest}" Style="{StaticResource DashboardTitle}" />
                                                <StackPanel Grid.Column="1"
                                                            MaxWidth="360"
                                                            Margin="18,0,0,0"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DeviceModelLabel}"
                                                               Style="{StaticResource BodyText}"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DeviceIdLabel}"
                                                               Style="{StaticResource HintUnderLabel}"
                                                               TextAlignment="Right"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,6" />
                                        </StackPanel>

                                        <Viewbox Grid.Row="1"
                                                 Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Margin="0,4">
                                            <Grid Width="{Binding ControllerVisualWidth}"
                                                  Height="{Binding ControllerVisualHeight}"
                                                  Cursor="Arrow">
                                                <layouts:DualSenseControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                       Height="{Binding ControllerVisualHeight}"
                                                                                       Visibility="{Binding IsDualSenseLayout, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:XboxControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                  Height="{Binding ControllerVisualHeight}"
                                                                                  Visibility="{Binding IsXboxOneVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:XboxSeriesControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                        Height="{Binding ControllerVisualHeight}"
                                                                                        Visibility="{Binding IsXboxSeriesVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:PlayStationControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                          Height="{Binding ControllerVisualHeight}"
                                                                                          Visibility="{Binding IsPlayStationVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:SwitchProControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                       Height="{Binding ControllerVisualHeight}"
                                                                                       Visibility="{Binding IsSwitchProVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:EightBitDoUltimateTesterView Width="{Binding ControllerVisualWidth}"
                                                                                      Height="{Binding ControllerVisualHeight}"
                                                                                      Visibility="{Binding IsEightBitDoUltimateVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:EightBitDoProTesterView Width="{Binding ControllerVisualWidth}"
                                                                                 Height="{Binding ControllerVisualHeight}"
                                                                                 Visibility="{Binding IsEightBitDoProVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:SteamControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                   Height="{Binding ControllerVisualHeight}"
                                                                                   Visibility="{Binding IsSteamControllerVisualScheme, Converter={StaticResource BoolToVisibility}}" />
                                                <layouts:UniversalControllerTesterView Width="{Binding ControllerVisualWidth}"
                                                                                       Height="{Binding ControllerVisualHeight}"
                                                                                       Visibility="{Binding IsUniversalControllerArtwork, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Viewbox>

                                        <StackPanel Grid.Row="2" HorizontalAlignment="Stretch">
                                            <StackPanel Width="260"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding IsVisualSchemeSelectorVisible, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_VisualScheme}"
                                                           Style="{StaticResource MetricLabel}"
                                                           TextAlignment="Center"
                                                           Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding VisualSchemeOptions}"
                                                          SelectedValue="{Binding SelectedVisualSchemeKey, Mode=TwoWay}"
                                                          SelectedValuePath="Key"
                                                          Foreground="{StaticResource PillIdleTextBrush}"
                                                          Background="{StaticResource IdleBrush}"
                                                          Height="28"
                                                          MaxDropDownHeight="240">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem">
                                                            <Setter Property="Foreground" Value="{StaticResource PillIdleTextBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                            <Setter Property="TextElement.Foreground" Value="{StaticResource PillIdleTextBrush}" />
                                                            <Setter Property="Padding" Value="8,5" />
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="{StaticResource PillIdleTextBrush}"
                                                                       Margin="4,1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <UniformGrid Columns="2" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                                <Button Content="{DynamicResource LOCCSM_Tester_ResetDiagnostics}"
                                                        Command="{Binding ResetDiagnosticsCommand}"
                                                        Height="32"
                                                        Margin="0,0,8,0" />
                                                <Button Content="{DynamicResource LOCCSM_Tester_ExportReport}"
                                                        Command="{Binding ExportReportCommand}"
                                                        Height="32" />
                                            </UniformGrid>
                                            <TextBlock Text="{Binding ExportReportStatusLabel}"
                                                       Style="{StaticResource HintText}"
                                                       TextAlignment="Center"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" MinHeight="0" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,12" VerticalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_ControllerHealth}" Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,12" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding HealthScoreDisplayLabel}" FontSize="20" FontWeight="SemiBold" />
                                                <StackPanel Grid.Column="1" Margin="16,6,0,0">
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding HealthDisplayProgress, Mode=OneWay}" Height="12" />
                                                    <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding HealthSummaryLabel}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding HealthConfidenceLabel}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,4">
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_ActiveInputs}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding ActiveButtonCount}" Style="{StaticResource MetricValue}" />
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_ButtonsCurrentlyPressed}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_CenterDrift}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding MaxDriftLabel}" Style="{StaticResource MetricValue}" />

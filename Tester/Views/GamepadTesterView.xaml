                                                <Path Data="{Binding RightStickTrailFadeGeometry}"
                                                      Stroke="#F7B955"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Opacity="0.18"
                                                      Visibility="{Binding IsStickCaptureRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <Path Data="{Binding RightStickTrailMidGeometry}"
                                                      Stroke="#F7B955"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Opacity="0.45"
                                                      Visibility="{Binding IsStickCaptureRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <Path Data="{Binding RightStickTrailRecentGeometry}"
                                                      Stroke="#F7B955"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Opacity="0.95"
                                                      Visibility="{Binding IsStickCaptureRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <Path Data="{Binding RightStickCircularCoverageGeometry}" Fill="{StaticResource WarningBrush}" Opacity="0.76" />
                                                <Path Data="{Binding RightStickPathGeometry}"
                                                      Stroke="#F7B955"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      Opacity="0.95"
                                                      Visibility="{Binding IsStickCaptureRunning, Converter={StaticResource BoolToVisibility}}" />
                                                <Ellipse Width="18" Height="18" Fill="#F7B955" Stroke="#FFF4DC" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform X="{Binding RightStickDiagnosticsDotX}" Y="{Binding RightStickDiagnosticsDotY}" />
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>

                                            <Grid Grid.Column="1" Margin="16,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding RightStickCircularCoverageLabel}" />
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding RightStickCircularCoveragePercent, Mode=OneWay}" Height="8" Margin="0,6,0,10" />
                                                    <TextBlock Text="{Binding RightStickMaxReachLabel}" />
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding RightStickMaxReachPercent, Mode=OneWay}" Height="8" Margin="0,6,0,10" />
                                                    <TextBlock Text="{Binding RightStickCurrentMagnitudeLabel}" />
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding RightStickCurrentMagnitudePercent, Mode=OneWay}" Height="8" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                                    <TextBlock Text="{Binding RightStickVector}" />
                                                    <TextBlock Text="{Binding RightStickAngleLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding RightStickDriftStatus}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding RightStickAxisRangeLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RightStickAverageMagnitudeLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                    <TextBlock Text="{Binding RightStickPathSampleLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource DashboardPanel}" Margin="0,0,12,0" VerticalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Top">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CenterCalibration}" Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,10" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CalibrationHelp}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,0,0,12" />
                                            <TextBlock Text="{Binding CalibrationStatusLabel}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding CalibrationProgress, Mode=OneWay}" Height="10" Margin="0,8,0,14" />
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Bottom"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,16,0,0">
                                            <Button Content="{DynamicResource LOCCSM_Tester_CaptureCenter}"
                                                    Command="{Binding StartCenterCalibrationCommand}"
                                                    Height="34"
                                                    MinWidth="140"
                                                    Margin="0,0,8,0" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_ResetCalibration}"
                                                    Command="{Binding ResetCalibrationCommand}"
                                                    Height="34"
                                                    MinWidth="140" />
                                        </StackPanel>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_LeftStick}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding LeftCalibrationCenterLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding LeftRecommendedDeadzoneLabel}" Margin="0,10,0,0" />
                                                <ProgressBar Minimum="0" Maximum="25" Value="{Binding LeftRecommendedDeadzonePercent, Mode=OneWay}" Height="8" Margin="0,6,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_RightStick}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding RightCalibrationCenterLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding RightRecommendedDeadzoneLabel}" Margin="0,10,0,0" />
                                                <ProgressBar Minimum="0" Maximum="25" Value="{Binding RightRecommendedDeadzonePercent, Mode=OneWay}" Height="8" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource DashboardPanel}" Margin="0" VerticalAlignment="Stretch">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Top">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RangeCalibration}" Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,10" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RangeCalibrationHelp}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,0,0,14" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Bottom"
                                                Content="{DynamicResource LOCCSM_Tester_ResetRange}"
                                                Command="{Binding ResetStickRangeCommand}"
                                                Height="34"
                                                MinWidth="140"
                                                Margin="0,16,0,0"
                                                HorizontalAlignment="Right" />
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_LeftStick}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding LeftRangeQualityLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding LeftRangeDisplayProgress, Mode=OneWay}" Height="10" Margin="0,6,0,8" />
                                                <TextBlock Text="{Binding LeftRangeConfidenceLabel}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding LeftStickAxisRangeLabel}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_RightStick}" Style="{StaticResource BodyText}" />
                                                <TextBlock Text="{Binding RightRangeQualityLabel}" Style="{StaticResource HintText}" Margin="0,8,0,0" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding RightRangeDisplayProgress, Mode=OneWay}" Height="10" Margin="0,6,0,8" />
                                                <TextBlock Text="{Binding RightRangeConfidenceLabel}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding RightStickAxisRangeLabel}" Style="{StaticResource HintText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE81E;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_TabLatency}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,12,4,0"
                          ClipToBounds="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource DashboardPanel}"
                                    Margin="0"
                                    ClipToBounds="False"
                                    VerticalAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="{DynamicResource LOCCSM_Tester_PollingLatencyTitle}"
                                                   Style="{StaticResource DashboardTitle}" />
                                        <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,10" />
                                        <TextBlock Text="{DynamicResource LOCCSM_Tester_LatencySimpleHelp}"
                                                   Style="{StaticResource HintText}" />
                                        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding PollingRateCurrentLabel}"
                                                       FontSize="36"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="{Binding PollingJitterLabel, StringFormat=Jitter {0}}"
                                                       FontFamily="Consolas"
                                                       Style="{StaticResource HintText}"
                                                       TextAlignment="Center"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Bottom"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,12,0,0">
                                        <Button Content="{Binding StartLatencyButtonLabel}"
                                                Command="{Binding StartLatencyTestCommand}"
                                                Height="42"
                                                MinWidth="170"
                                                Margin="0,0,10,0" />
                                        <Button Content="{DynamicResource LOCCSM_Tester_ResetLatency}"
                                                Command="{Binding ResetLatencyCommand}"
                                                Height="42"
                                                MinWidth="150"
                                                Margin="0,0,10,0" />
                                        <Button Content="{DynamicResource LOCCSM_Tester_ExportLatency}"
                                                Command="{Binding ExportLatencyCommand}"
                                                Height="42"
                                                MinWidth="150" />
                                    </StackPanel>
                                    <controls:LatencyRateChart Margin="0,12,0,12"
                                                               MinHeight="0"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch"
                                                               Values="{Binding LatencyRateGraphValues}"
                                                               AccentBrush="{DynamicResource GlyphBrush}"
                                                               GridBrush="{StaticResource LineBrush}"
                                                               LabelBrush="{StaticResource TextMutedBrush}"
                                                               PlotBackgroundBrush="{DynamicResource ControlBackgroundBrush}" />
                                </DockPanel>
                            </Border>

                            <ScrollViewer Grid.Column="1"
                                          Margin="22,0,0,0"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                    <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_DeviceConnected}"
                                                       Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding DeviceModelLabel}"
                                                       Style="{StaticResource BodyText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_MaxRate}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding PollingRateMaxValueLabel}" Style="{StaticResource MetricValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_AverageRate}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding PollingRateAverageValueLabel}" Style="{StaticResource MetricValue}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_LatencySamples}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding LatencySampleCountLabel}" Style="{StaticResource MetricValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_LatencyRange}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding LatencyRangeLabel}" Style="{StaticResource MetricValue}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource DashboardMetricTile}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource LOCCSM_Tester_LatencyDuration}" Style="{StaticResource DashboardTitle}" />
                                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding LatencyTestDurationLabel}" Style="{StaticResource MetricValue}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_EstimatedDelay}" Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding EstimatedDelayLabel}"
                                                       FontSize="20"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}" />
                                            <TextBlock Text="{Binding LatencyStatusLabel}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding LatencyConfidenceLabel}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding InputEventLatencyAverageLabel}"
                                                       TextWrapping="Wrap"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,12">
                                    <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_PerformanceReference}"
                                                       Style="{StaticResource DashboardTitle}" />
                                            <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,8" />
                                            <TextBlock Text="USB / 2.4G  ~1000 Hz" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="Bluetooth  125 - 250 Hz" Style="{StaticResource BodyText}" Margin="0,8,0,0" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_LatencyHelp}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE8F1;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_GuidedTest}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:GuidedTestView Margin="4,12,4,0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE8A5;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_TabInputLog}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,12,4,0"
                          ClipToBounds="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="0" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DashboardPanel}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_Tester_TabInputLog}" Style="{StaticResource DashboardTitle}" />
                                <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsInputLogEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource LOCCSM_Tester_EnableInputLog}"
                                               FontWeight="Normal"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="{DynamicResource LOCCSM_Tester_ExportInputLog}"
                                                Command="{Binding ExportInputLogCommand}"
                                                Height="34"
                                                MinWidth="150"
                                                Margin="0,0,8,0" />
                                        <Button Content="{DynamicResource LOCCSM_Tester_ResetInputLog}"
                                                Command="{Binding ResetInputLogCommand}"
                                                Height="34"
                                                MinWidth="110" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding InputLogExportStatusLabel}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource DashboardPanel}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource LOCCSM_Tester_InputHistory}" Style="{StaticResource DashboardTitle}" />
                                <Border Grid.Row="1" Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,12" />
                                <Border Grid.Row="2"
                                        Visibility="{Binding IsInputLogDisabled, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource LOCCSM_Tester_InputLogDisabled}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center" />
                                        <TextBlock Text="{DynamicResource LOCCSM_Tester_InputLogDisabledHelp}"
                                                   Style="{StaticResource HintText}"
                                                   TextAlignment="Center"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <ListBox Grid.Row="2"
                                         ItemsSource="{Binding InputHistory}"
                                         Background="{DynamicResource ListBoxBackgroundBrush}"
                                         BorderBrush="{StaticResource LineBrush}"
                                         Visibility="{Binding IsInputLogEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,9"
                                                    Background="{DynamicResource ControlBackgroundBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeLabel}"
                                                               FontFamily="Consolas"
                                                               Style="{StaticResource HintText}"
                                                               VerticalAlignment="Center" />
                                                    <Border x:Name="InputKeyBox"
                                                            Grid.Column="1"
                                                            Background="{StaticResource IdleBrush}"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Height="34"
                                                            Padding="8,0"
                                                            TextElement.Foreground="{DynamicResource TextBrush}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding InputName}"
                                                                   FontWeight="Normal"
                                                                   FontSize="12"
                                                                   TextAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DetailLabel}"
                                                                   Style="{StaticResource HintText}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Border x:Name="StateBadge"
                                                            Grid.Column="3"
                                                            Style="{StaticResource InputPill}"
                                                            Margin="0"
                                                            Background="#8A3A16"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State}"
                                                                   FontWeight="Normal"
                                                                   FontSize="12"
                                                                   Foreground="#FFF4E8" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Pressed">
                                                    <Setter TargetName="InputKeyBox" Property="Background" Value="#1D6B50" />
                                                    <Setter TargetName="InputKeyBox" Property="BorderBrush" Value="#1D6B50" />
                                                    <Setter TargetName="InputKeyBox" Property="TextElement.Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="StateBadge" Property="Background" Value="#1D6B50" />
                                                    <Setter TargetName="StateBadge" Property="TextElement.Foreground" Value="#EFFFF7" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Released">
                                                    <Setter TargetName="InputKeyBox" Property="Background" Value="#1F5E9D" />
                                                    <Setter TargetName="InputKeyBox" Property="BorderBrush" Value="#1F5E9D" />
                                                    <Setter TargetName="InputKeyBox" Property="TextElement.Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="StateBadge" Property="Background" Value="#1F5E9D" />
                                                    <Setter TargetName="StateBadge" Property="TextElement.Foreground" Value="#EEF7FF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Changed">
                                                    <Setter TargetName="InputKeyBox" Property="Background" Value="#A84B37" />
                                                    <Setter TargetName="InputKeyBox" Property="BorderBrush" Value="#A84B37" />
                                                    <Setter TargetName="InputKeyBox" Property="TextElement.Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="StateBadge" Property="Background" Value="#A84B37" />
                                                    <Setter TargetName="StateBadge" Property="TextElement.Foreground" Value="#FFF2F0" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE946;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_TabDeviceInfo}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,12,4,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="0" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Style="{StaticResource DashboardPanel}"
                                    Margin="0,0,0,12"
                                    Padding="24,22"
                                    VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CompatibilityAssistant}" Style="{StaticResource DashboardTitle}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CompatibilityAssistantHelp}"
                                                       Style="{StaticResource HintText}"
                                                       Margin="0,8,18,0" />
                                        </StackPanel>
                                        <Border x:Name="CompatibilityStatusBadge"
                                                Grid.Column="1">
                                            <TextBlock Text="{Binding CompatibilityAssistantStatusLabel}"
                                                       FontWeight="Normal"
                                                       FontSize="12"
                                                       Foreground="White" />
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource InputPill}">
                                                    <Setter Property="Margin" Value="0" />
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                    <Setter Property="Background" Value="#667080" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CompatibilityAssistantStatus}" Value="Ready">
                                                            <Setter Property="Background" Value="#267A4A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CompatibilityAssistantStatus}" Value="Info">
                                                            <Setter Property="Background" Value="#376A91" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CompatibilityAssistantStatus}" Value="Warning">
                                                            <Setter Property="Background" Value="#A56B19" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CompatibilityAssistantStatus}" Value="Limited">
                                                            <Setter Property="Background" Value="#9A4438" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,0,0,16" />
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CompatibilityInputMode}" Style="{StaticResource HintText}" />
                                            <TextBlock Text="{Binding CompatibilityInputModeLabel}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CompatibilityMappingCoverage}" Style="{StaticResource HintText}" />
                                            <TextBlock Text="{Binding CompatibilityMappingCoverageLabel}" Style="{StaticResource BodyText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CompatibilityFindings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="FindingSeverity" CornerRadius="2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#667080" />
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Style="{StaticResource HintUnderLabel}" />
                                                        <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,10,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Ready">
                                                        <Setter TargetName="FindingSeverity" Property="Background" Value="#267A4A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                        <Setter TargetName="FindingSeverity" Property="Background" Value="#376A91" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter TargetName="FindingSeverity" Property="Background" Value="#A56B19" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Limited">
                                                        <Setter TargetName="FindingSeverity" Property="Background" Value="#9A4438" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource DashboardPanel}" Margin="0" Padding="20,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                    <TextBlock Text="{DynamicResource LOCCSM_Tester_DeviceSection}" Style="{StaticResource DashboardTitle}" />
                                    <TextBlock Text="{Binding SelectedController.DisplayName}"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="{DynamicResource LOCCSM_Tester_DeviceSelectedHelp}"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasMultipleControllers, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Style="{StaticResource SubtleHorizontalSeparator}" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{DynamicResource LOCCSM_Tester_Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding State.ControllerName}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource LOCCSM_Tester_DetectedModel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeviceModelLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="3" Text="{DynamicResource LOCCSM_Tester_VidPid}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceIdLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource LOCCSM_Tester_Layout}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding State.Layout}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource LOCCSM_Tester_Backend}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BackendLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="6" Text="{DynamicResource LOCCSM_Tester_MappingStatus}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding MappingStatusLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="7" Text="{DynamicResource LOCCSM_Tester_InputApi}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DeviceApiLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="8" Text="{DynamicResource LOCCSM_Tester_Capabilities}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DeviceCapabilitiesLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="9" Text="{DynamicResource LOCCSM_Tester_ExtraControls}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ExtraButtonDetailLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="10" Text="{DynamicResource LOCCSM_Tester_Rumble}" Style="{StaticResource FieldLabel}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding DeviceRumbleCapabilityLabel}" Style="{StaticResource BodyText}" Margin="0,0,0,16" />
                                <TextBlock Grid.Row="11" Text="{DynamicResource LOCCSM_Tester_Notes}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{DynamicResource LOCCSM_Tester_DeviceNotes}" Style="{StaticResource HintText}" />
                                <Grid Grid.Row="12" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{DynamicResource LOCCSM_Tester_ExportCompatibilityReport}"
                                            Command="{Binding ExportCompatibilityReportCommand}"
                                            Height="36"
                                            MinWidth="210" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CompatibilityReportStatusLabel}"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource HintText}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                            </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE9D9;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_DiagnosticProfile}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4,12,4,0"
                          ClipToBounds="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch">
                        <Border Style="{StaticResource DashboardPanel}"
                                Margin="0"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="0" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource LOCCSM_Tester_DiagnosticProfile}"
                                           Style="{StaticResource DashboardTitle}" />
                                <Border Grid.Row="1"
                                        Style="{StaticResource SubtleHorizontalSeparator}"
                                        Margin="0,0,0,10" />
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:DiagnosticRadarChart MinHeight="0"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Stretch"
                                                                   Values="{Binding DiagnosticRadarValues}"
                                                                   Labels="{Binding DiagnosticRadarLabels}"
                                                                   AccentBrush="{DynamicResource GlyphBrush}"
                                                                   ValueBrush="{DynamicResource GlyphBrush}"
                                                                   GridBrush="{StaticResource LineBrush}"
                                                                   LabelBrush="{StaticResource PillIdleTextBrush}" />
                                    <ScrollViewer Grid.Column="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalAlignment="Stretch">
                                    <StackPanel Margin="28,4,8,0"
                                                VerticalAlignment="Top">
                                        <TextBlock Text="{DynamicResource LOCCSM_Tester_DiagnosticProfileHelp}"
                                                   Style="{StaticResource HintText}"
                                                   Margin="0,0,0,18" />
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_CenterDrift}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarCenterAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenSticks}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenSticksTabCommand}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_LeftStick}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarLeftStickAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenSticks}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenSticksTabCommand}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RightStick}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarRightStickAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenSticks}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenSticksTabCommand}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_Triggers}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarTriggersAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenGeneral}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenGeneralTestTabCommand}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_SessionCoverage}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarControlsAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenGuided}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenGuidedTabCommand}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_InputEventLatency}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Tester_RadarTimingAction}" Style="{StaticResource HintUnderLabel}" />
                                            <Button Content="{DynamicResource LOCCSM_Tester_RadarOpenLatency}"
                                                    Style="{StaticResource RadarActionButton}"
                                                    Command="{Binding OpenLatencyTabCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Visibility="{Binding IsOptionsTabVisible, Converter={StaticResource BoolToVisibility}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE713;" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_TabOptions}" Style="{StaticResource TabHeaderLabel}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,4,8,16">
                            <StackPanel Margin="0,0,0,24">
                                <Border Style="{StaticResource PageHeader}">
                                    <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsPlayniteIntegration}"
                                               Style="{StaticResource SectionHeaderText}" />
                                </Border>
                            </StackPanel>
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsShowSidebar}"
                                      IsChecked="{Binding Settings.ShowSidebarItem}" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsShowSidebarHelp}"
                                       Style="{StaticResource HintText}" Margin="22,8,0,16" />
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsFullscreenWindow}"
                                      IsChecked="{Binding Settings.UseFullscreenFriendlyWindow}" />
                            <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsFullscreenWindowHelp}"
                                       Style="{StaticResource HintText}" Margin="22,8,0,24" />

                            <StackPanel Margin="0,0,0,24">
                                <Border Style="{StaticResource PageHeader}">
                                    <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsTestingBehavior}"
                                               Style="{StaticResource SectionHeaderText}" />
                                </Border>
                            </StackPanel>
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsResetOnSwitch}"
                                      IsChecked="{Binding Settings.AutoResetDiagnosticsOnControllerChange}" Margin="0,0,0,8" />
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsShowSingleSelector}"
                                      IsChecked="{Binding Settings.ShowDeviceSelectorWhenSingleController}" Margin="0,0,0,8" />
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsEnableRumble}"
                                      IsChecked="{Binding Settings.EnableRumbleTests}" Margin="0,0,0,8" />
                            <CheckBox Content="{DynamicResource LOCCSM_Tester_SettingsInputLogDefault}"
                                      IsChecked="{Binding Settings.EnableInputLogByDefault}" Margin="0,0,0,24" />

                            <StackPanel Margin="0,0,0,24">
                                <Border Style="{StaticResource PageHeader}">
                                    <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsThresholds}"
                                               Style="{StaticResource SectionHeaderText}" />
                                </Border>
                                <TextBlock Text="{DynamicResource LOCCSM_Tester_SettingsThresholdsHelp}"
                                           Style="{StaticResource HintText}" FontStyle="Italic" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{DynamicResource LOCCSM_Tester_SettingsHealthyDeadzone}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Settings.HealthyDeadzone}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="{DynamicResource LOCCSM_Tester_SettingsMinorDrift}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Settings.MinorDriftThreshold}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Text="{DynamicResource LOCCSM_Tester_SettingsAttentionDrift}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Settings.AttentionDriftThreshold}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Text="{DynamicResource LOCCSM_Tester_SettingsStickEdge}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Settings.StickEdgeThreshold}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Text="{DynamicResource LOCCSM_Tester_SettingsTriggerFullPress}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding Settings.TriggerFullPressThreshold}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Text="{DynamicResource LOCCSM_Tester_SettingsCalibrationDuration}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding Settings.CenterCalibrationMilliseconds}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                </TabControl>

                <Border Grid.Row="1"
                        Margin="2,10,2,0"
                        Padding="12,8"
                        CornerRadius="6"
                        Background="{StaticResource IdleBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsFullscreenSimplifiedMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FullscreenNavigationHint}"
                               Style="{StaticResource HintText}"
                               Foreground="{StaticResource PillIdleTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </Border>

            </Grid>
    </Grid>
</UserControl>

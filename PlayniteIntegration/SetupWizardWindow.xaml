<Window x:Class="ControllerSessionManager.PlayniteIntegration.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Narian.Bg}"
        Foreground="{DynamicResource TextBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        TextElement.FontSize="14"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown"
        Loaded="OnWindowLoaded"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WizardTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="WizardStepLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="WizardBody" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="WizardHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,8,0,16"/>
            </Style>
            <Style x:Key="WizardWarning" TargetType="TextBlock" BasedOn="{StaticResource WizardHint}">
                <Setter Property="Foreground" Value="#FFE24B4B"/>
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="WizardSummaryLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Narian.TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="WizardSummaryValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="WizardSummaryRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource Narian.Border}" BorderThickness="1" CornerRadius="4"
            Background="{DynamicResource Narian.Bg}">
        <DockPanel LastChildFill="True" Margin="24,20">
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,24,0,0">
                <Button x:Name="SkipButton" DockPanel.Dock="Left"
                        HorizontalAlignment="Left" MinWidth="120" Margin="0,0,16,0"
                        Click="SkipClick"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Click="BackClick" MinWidth="100" Margin="0,0,8,0"/>
                    <Button x:Name="NextButton" Style="{StaticResource WizardPrimaryButton}"
                            IsDefault="True" Click="NextClick"/>
                </StackPanel>
                <Border/>
            </DockPanel>

            <StackPanel>
                <Border Background="Transparent" Cursor="SizeAll" Padding="0,0,0,8"
                        MouseLeftButtonDown="OnDragAreaMouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock x:Name="StepLabel" Style="{StaticResource WizardStepLabel}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="StepTitle" Style="{StaticResource WizardTitle}"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StepHelp" Style="{StaticResource WizardBody}"/>

                <!-- Step 0: Welcome -->
                <StackPanel x:Name="StepWelcome" Visibility="Collapsed">
                    <TextBlock x:Name="WelcomeBody" Style="{StaticResource WizardBody}"/>
                </StackPanel>

                <!-- Step 1: Auto-pause -->
                <StackPanel x:Name="StepPause" Visibility="Collapsed">
                    <RadioButton x:Name="PauseNone" GroupName="WizardAutoPause" Margin="0,0,0,0"/>
                    <TextBlock x:Name="PauseNoneHelp" Style="{StaticResource WizardHint}"/>
                    <RadioButton x:Name="PauseOffline" GroupName="WizardAutoPause" Margin="0,0,0,0"
                                Checked="PauseModeChanged" Unchecked="PauseModeChanged"/>
                    <TextBlock x:Name="PauseOfflineHelp" Style="{StaticResource WizardHint}" Margin="0,8,0,8"/>
                    <TextBlock x:Name="PauseOfflineWarning" Style="{StaticResource WizardWarning}"
                               Visibility="Collapsed"/>
                    <RadioButton x:Name="PauseAlways" GroupName="WizardAutoPause" Margin="0,0,0,0"
                                Checked="PauseModeChanged" Unchecked="PauseModeChanged"/>
                    <TextBlock x:Name="PauseAlwaysHelp" Style="{StaticResource WizardHint}" Margin="0,8,0,8"/>
                    <TextBlock x:Name="PauseAlwaysWarning" Style="{StaticResource WizardWarning}"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Step 2: Feedback -->
                <StackPanel x:Name="StepFeedback" Visibility="Collapsed">
                    <CheckBox x:Name="OverlayCheck" Margin="0,0,0,0"/>
                    <TextBlock x:Name="OverlayHelp" Style="{StaticResource WizardHint}"/>
                    <CheckBox x:Name="FullscreenToastCheck" Margin="0,0,0,8"/>
                    <CheckBox x:Name="DesktopToastCheck" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Step 3: Access -->
                <StackPanel x:Name="StepAccess" Visibility="Collapsed">
                    <TextBlock x:Name="TopPanelLabel" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <RadioButton x:Name="TopHidden" GroupName="WizardTopPanel" Margin="0,0,0,8"/>
                    <RadioButton x:Name="TopDefault" GroupName="WizardTopPanel" Margin="0,0,0,8"/>
                    <RadioButton x:Name="TopPrimary" GroupName="WizardTopPanel" Margin="0,0,0,16"/>
                    <CheckBox x:Name="SidebarCheck" Margin="0,0,0,0"/>
                    <TextBlock x:Name="SidebarHelp" Style="{StaticResource WizardHint}"/>
                    <CheckBox x:Name="GuideCheck" Margin="0,0,0,0"/>
                    <TextBlock x:Name="GuideHelp" Style="{StaticResource WizardHint}"/>
                </StackPanel>

                <!-- Step 4: Summary -->
                <StackPanel x:Name="StepSummary" Visibility="Collapsed">
                    <StackPanel x:Name="SummaryRows"/>
                    <TextBlock x:Name="SummaryHelp" Style="{StaticResource WizardHint}" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

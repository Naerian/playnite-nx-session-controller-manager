                                            <ComboBoxItem Tag="Manual" Content="{DynamicResource LOCCSM_CreatorThemeUpdateManual}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xEC7A;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabAdvanced}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TabControl Style="{StaticResource SettingsNavigationTabControl}" Tag="{DynamicResource LOCCSM_TabAdvanced}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE8F1;" />
                                <TextBlock Text="{DynamicResource LOCCSM_TabSetup}" Style="{StaticResource TabHeaderLabel}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Style="{StaticResource FillScrollViewer}">
                            <StackPanel Margin="16,16,16,16">
                                <StackPanel Style="{StaticResource PageSection}">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCCSM_TabSetup}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCCSM_SetupPageHelp}" Style="{StaticResource SectionSubtitleText}" />
                                </StackPanel>
                                <Button Content="{DynamicResource LOCCSM_OpenSetupWizard}" HorizontalAlignment="Left"
                                        MinWidth="220" Style="{StaticResource NarianPrimaryButton}"
                                        Click="OpenSetupWizardClick" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabGlyph}" Text="&#xEC4A;" />
                                <TextBlock Text="{DynamicResource LOCCSM_Monitoring}" Style="{StaticResource TabHeaderLabel}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Style="{StaticResource FillScrollViewer}">
                            <StackPanel Margin="16,16,16,16">
                                <StackPanel Style="{StaticResource PageSection}">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCCSM_Monitoring}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCCSM_GeneralHelp}" Style="{StaticResource SectionSubtitleText}" />
                                </StackPanel>
                                <CheckBox Content="{DynamicResource LOCCSM_ReconciliationInterval}" IsChecked="{Binding EnableMonitoring}" />
                                <TextBlock Text="{DynamicResource LOCCSM_ReconciliationHelp}" Style="{StaticResource ControlHintText}" />
                                <DockPanel LastChildFill="False" Margin="22,0,0,0" IsEnabled="{Binding EnableMonitoring}">
                                    <TextBox Width="72" Text="{Binding ReconciliationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{DynamicResource LOCCSM_Seconds}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE9D9;" />
                                <TextBlock Text="{DynamicResource LOCCSM_DiagnosticsTitle}" Style="{StaticResource TabHeaderLabel}" />
                            </StackPanel>
                        </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="16,16,16,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_DiagnosticsTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_AdvancedHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource LOCCSM_EnableDebugLogging}" IsChecked="{Binding EnableDebugLogging}" Margin="0,0,0,24" />
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_ControllerDatabaseTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_ControllerDatabaseHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource LOCCSM_ControllerDatabaseAutoUpdate}"
                                  IsChecked="{Binding AutoUpdateControllerDatabase}" Margin="0,0,0,12" />
                        <Button Content="{DynamicResource LOCCSM_ControllerDatabaseCheckNow}"
                                HorizontalAlignment="Left" MinWidth="180"
                                Style="{StaticResource {x:Type Button}}"
                                Click="CheckControllerDatabaseUpdatesClick" Margin="0,0,0,24" />
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_SupportReport}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_SupportReportHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <Button Content="{DynamicResource LOCCSM_ExportSupportReport}" HorizontalAlignment="Left"
                                MinWidth="180" Style="{StaticResource NarianPrimaryButton}" Click="ExportSupportReportClick" />
                        <StackPanel Style="{StaticResource PageSection}" Margin="0,24,0,24">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_HidDiagnostics}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_HidDiagnosticsHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <Button Content="{DynamicResource LOCCSM_ExportHidDiagnostics}" HorizontalAlignment="Left"
                                MinWidth="180" Style="{StaticResource {x:Type Button}}" Click="ExportHidDiagnosticsClick" />
                    </StackPanel>
                </ScrollViewer>
                    </TabItem>
                </TabControl>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE713;" />
                        <TextBlock Text="{DynamicResource LOCCSM_DesktopIntegrationTitle}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="16,16,16,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_TopPanelSectionTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_ShowPrimaryInTopPanelHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldGroup}">
                            <RadioButton Content="{DynamicResource LOCCSM_TopPanelModeHidden}"
                                         GroupName="TopPanelControllerMode"
                                         Margin="0,0,0,8"
                                         IsChecked="{Binding TopPanelControllerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Hidden}" />
                            <RadioButton Content="{DynamicResource LOCCSM_TopPanelModeDefault}"
                                         GroupName="TopPanelControllerMode"
                                         Margin="0,0,0,8"
                                         IsChecked="{Binding TopPanelControllerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Default}" />
                            <RadioButton Content="{DynamicResource LOCCSM_TopPanelModePrimary}"
                                         GroupName="TopPanelControllerMode"
                                         Margin="0,0,0,8"
                                         IsChecked="{Binding TopPanelControllerMode, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Primary}" />
                            <CheckBox Content="{DynamicResource LOCCSM_ColorTopPanelByBattery}" IsChecked="{Binding ColorTopPanelIndicatorByBattery}"
                                      Margin="0,8,0,0" IsEnabled="{Binding IsTopPanelButtonVisible}" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource PageSection}" Margin="0,24,0,0">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_GuideFullscreenSectionTitle}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_LaunchFullscreenOnGuideHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldGroup}">
                            <CheckBox Content="{DynamicResource LOCCSM_LaunchFullscreenOnGuide}"
                                      IsChecked="{Binding LaunchFullscreenOnGuideButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE946;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabAbout}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_TabAbout}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_AboutDescription}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <TextBlock x:Name="AboutVersionText" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <TextBlock x:Name="AboutLegacyGamepadTesterWarning" Style="{StaticResource WarningHintText}"
                                   Text="{DynamicResource LOCCSM_LegacyGamepadTesterWarning}"
                                   Visibility="Collapsed" Margin="0,0,0,16" />

                        <Border Style="{StaticResource ElevatedCard}">
                            <StackPanel>
                                <Border Style="{StaticResource SectionHeaderBorder}">
                                    <TextBlock Text="{DynamicResource LOCCSM_AboutWhatItDoesTitle}" Style="{StaticResource SectionHeaderText}" />
                                </Border>
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities2}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities3}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities4}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCCSM_ProjectLinksTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="GitHub" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager"
                                            MinWidth="100" Margin="0,0,8,8" Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCCSM_OpenWiki}" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager/wiki"
                                            MinWidth="100" Margin="0,0,8,8" Click="OpenExternalButton" />
                                    <Button Content="{DynamicResource LOCCSM_ReportIssue}" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager/issues/new"
                                            MinWidth="140" Margin="0,0,0,8" Click="OpenExternalButton" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Style="{StaticResource PageSection}" Margin="0,0,0,16">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCCSM_SupportTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                </StackPanel>
                                <Button Content="{DynamicResource LOCCSM_KoFiSupport}" Tag="https://ko-fi.com/naerian"
                                        HorizontalAlignment="Left" MinWidth="150" Padding="16,8"
                                        Click="OpenExternalButton" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

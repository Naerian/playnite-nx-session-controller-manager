                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter Property="Margin" Value="0,0,0,24" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ControllerCard}">
                                                    <StackPanel>
                                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SummaryCardTitle}"

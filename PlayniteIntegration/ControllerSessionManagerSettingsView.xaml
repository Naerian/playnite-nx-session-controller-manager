                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">

<UserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerSessionManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControllerSessionManager.PlayniteIntegration"
             xmlns:tester="clr-namespace:ControllerSessionManager.Tester.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinWidth="980" MinHeight="640" d:DesignHeight="780" d:DesignWidth="1100"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{DynamicResource Narian.Bg}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <local:IconGeometryConverter x:Key="IconGeometryConverter" />
        <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <local:PreviewScaleConverter x:Key="PreviewScaleConverter" />
        <local:NumberToThicknessConverter x:Key="NumberToThicknessConverter" />
        <local:NumberToCornerRadiusConverter x:Key="NumberToCornerRadiusConverter" />
        <local:OptionalBorderThicknessConverter x:Key="OptionalBorderThicknessConverter" />
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="NarianPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Narian.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggleTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCCSM_SelectColor}" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="PageHeader" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}" />
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style x:Key="ControlHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="ControlHintTextLast" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="IconSquareButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Transparent square used by expander chevrons; theme Button padding offsets Path otherwise. -->
        <Style x:Key="ExpanderChevronButton" TargetType="Button" BasedOn="{StaticResource IconSquareButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SliderRangeText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="AppearanceGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="OverlayAppearanceGroup" TargetType="Border" BasedOn="{StaticResource AppearanceGroup}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="AppearanceGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OverlayAppearanceGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource AppearanceGroupHeader}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PageSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Flat section wrapper: forms sit on page bg (MetaDataIA / Audio Switcher). -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ElevatedCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="InfoCallout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="InfoCalloutAccentBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Background" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="InfoCalloutTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="InfoCalloutBody" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="InfoCalloutGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,10,0" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ControllerCard" TargetType="Border" BasedOn="{StaticResource SummaryCard}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="CapabilityPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="CompactSliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlaySliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="CompactChoicePanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="StackedColorPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlayColorPanel" TargetType="StackPanel" BasedOn="{StaticResource StackedColorPanel}" />
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ControllerTableBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ControllerTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Narian.TableHeader}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ControllerTableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Narian.RowOdd}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource Narian.RowEven}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="AlternationIndex" Value="1" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTable" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ControllerTableHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource ControllerTableCell}" />
            <Setter Property="RowStyle" Value="{StaticResource ControllerTableRow}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="Cell" />
        </Style>
        <Style x:Key="TabGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="52" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource Narian.Surface}" />
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Margin="16,8,8,8" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  HorizontalAlignment="Stretch"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock x:Name="ExpanderHint" Grid.Row="1"
                                                           Text="{DynamicResource LOCCSM_ExpandSectionHint}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,8,0,0" />
                                            </Grid>
                                        </ToggleButton>
                                        <Button x:Name="ExpanderChevron" Grid.Column="1"
                                                Style="{StaticResource ExpanderChevronButton}"
                                                VerticalAlignment="Center"
                                                Click="ExpanderChevronButton_OnClick">
                                            <Path x:Name="ExpanderArrow"
                                                  Width="12" Height="7"
                                                  Stretch="Uniform"
                                                  Data="M0,0 L6,6 L12,0"
                                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,16,8,16"
                                    TextElement.Foreground="{DynamicResource TextBrush}"
                                    TextElement.FontSize="14">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource Narian.Accent}" />
                                <Setter TargetName="ExpanderHint" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ExpanderArrow" Property="Data" Value="M0,6 L6,0 L12,6" />
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact nested expanders for Layout/Content/Shape/Colors (no hint row). -->
        <Style x:Key="AppearanceSectionExpander" TargetType="Expander" BasedOn="{StaticResource SettingsExpander}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="40" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource Narian.Surface}" />
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                              RecognizesAccessKey="True"
                                                              Margin="16,8,8,8"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Stretch"
                                                              TextElement.Foreground="{DynamicResource TextBrush}" />
                                        </ToggleButton>
                                        <Button x:Name="ExpanderChevron" Grid.Column="1"
                                                Style="{StaticResource ExpanderChevronButton}"
                                                VerticalAlignment="Center"
                                                Click="ExpanderChevronButton_OnClick">
                                            <Path x:Name="ExpanderArrow"
                                                  Width="12" Height="7"
                                                  Stretch="Uniform"
                                                  Data="M0,0 L6,6 L12,0"
                                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,12,16,12"
                                    TextElement.Foreground="{DynamicResource TextBrush}"
                                    TextElement.FontSize="14">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource Narian.Accent}" />
                                <Setter TargetName="ExpanderArrow" Property="Data" Value="M0,6 L6,0 L12,6" />
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Rectangle x:Name="NavigationFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <Rectangle x:Name="NavigationAccent" Width="4" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="16,8,16,8"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource Narian.Selected}" />
                                <Setter TargetName="NavigationAccent" Property="Fill" Value="{DynamicResource Narian.Accent}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                    Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    BorderThickness="0"
                                    ClipToBounds="False">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource Narian.Accent}" FontSize="14" FontWeight="SemiBold"
                                               Margin="8,8,8,16" TextWrapping="Wrap" />
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Rectangle x:Name="TabFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="16,8"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFill" Property="Fill" Value="{DynamicResource Narian.Selected}" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabs" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource TopTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                    Padding="6" ClipToBounds="False"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <WrapPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <Grid Grid.Row="1" Margin="0,16,0,0" ClipToBounds="False">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  ClipToBounds="False" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="16,16">
        <TabControl x:Name="RootTabs" Style="{StaticResource TopTabs}" SelectionChanged="RootTabsSelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE80F;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabOverview}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource FillScrollViewer}">
                    <StackPanel Margin="8,8,8,16">
                        <StackPanel Style="{StaticResource PageSection}">
                            <Border Style="{StaticResource PageHeader}">
                                <TextBlock Text="{DynamicResource LOCCSM_TabOverview}" Style="{StaticResource SectionHeaderText}" />
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_OverviewHelp}" Style="{StaticResource SectionSubtitleText}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_AppearancePreset}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{DynamicResource LOCCSM_AppearancePresetHelp}" Style="{StaticResource FieldHintText}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="AppearancePresetChips" Orientation="Horizontal"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="ConnectedCountText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                    <TextBlock x:Name="SessionStatusPillText" />
                                                </Border>
                                                <TextBlock Text="{DynamicResource LOCCSM_SessionStatus}" Style="{StaticResource SummaryCardTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="SessionStatusText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}">
                                                    <TextBlock x:Name="XInputStatusPillText" />
                                                </Border>
                                                <TextBlock Text="{DynamicResource LOCCSM_XInputProvider}" Style="{StaticResource SummaryCardTitle}" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock x:Name="XInputStatusText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_PrimaryController}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="PrimaryControllerText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_LastRefresh}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="LastRefreshText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_ActiveSessionControllers}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="ActiveSessionControllersText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE7FC;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabControllers}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8,4,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource PageHeader}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCSM_Refresh}"
                                        Style="{StaticResource {x:Type Button}}" Margin="16,0,0,0"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Click="RefreshControllersClick" />
                                <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SectionHeaderText}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource LOCCSM_ControllersHelp}" Style="{StaticResource SectionSubtitleText}" />
                            <TextBlock Style="{StaticResource NoteText}">
                                <Run FontWeight="SemiBold" Text="{DynamicResource LOCCSM_NotePrefix}" />
                                <Run Text=" " />
                                <Run Text="{DynamicResource LOCCSM_BatteryUnknownHint}" />
                            </TextBlock>
                            <TextBlock x:Name="LegacyGamepadTesterWarning" Style="{StaticResource WarningHintText}"
                                       Text="{DynamicResource LOCCSM_LegacyGamepadTesterWarning}"
                                       Visibility="Collapsed" Margin="0,8,0,0" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" Style="{StaticResource FillScrollViewer}" Margin="0,24,0,0">
                                <Grid MinHeight="120" VerticalAlignment="Top">
                                    <ItemsControl x:Name="ControllerList" AlternationCount="2" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="0,0,24,24" />
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                                <Style.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter Property="Margin" Value="0,0,0,24" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource ControllerCard}">
                                                    <StackPanel>
                                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SummaryCardTitle}"
                                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </Border>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Viewbox Width="56" Height="56" Margin="0,0,16,0"
                                                                     VerticalAlignment="Top"
                                                                     HorizontalAlignment="Center">
                                                                <Path Data="{Binding IconGeometry, Converter={StaticResource IconGeometryConverter}}"
                                                                      Fill="{DynamicResource TextBrush}"
                                                                      Stroke="{DynamicResource TextBrush}"
                                                                      StrokeThickness="0.18"
                                                                      StrokeLineJoin="Round"
                                                                      Stretch="Uniform" />
                                                            </Viewbox>
                                                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <Border Style="{StaticResource CapabilityPill}"
                                                                            Margin="0,0,8,8"
                                                                            ToolTip="{Binding ConnectionTooltip}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0"
                                                                                     VerticalAlignment="Center">
                                                                                <Path Data="{Binding ConnectionIconGeometry, Converter={StaticResource IconGeometryConverter}}"
                                                                                      Stroke="{Binding ConnectionBrush}" StrokeThickness="2"
                                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                      StrokeLineJoin="Round" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                            <TextBlock Text="{Binding Connection}" Foreground="{Binding ConnectionBrush}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Style="{StaticResource CapabilityPill}"
                                                                            Margin="0,0,8,8"
                                                                            ToolTip="{Binding BatteryTooltip}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="8" Height="8" Fill="{Binding BatteryBrush}"
                                                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Battery}" Foreground="{Binding BatteryBrush}"
                                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Style="{StaticResource CapabilityPill}"
                                                                            Margin="0,0,0,8"
                                                                            ToolTip="{Binding ProviderTooltip}">
                                                                        <TextBlock Text="{Binding Provider}" />
                                                                    </Border>
                                                            </WrapPanel>
                                                        </Grid>
                                                        <Grid Margin="0,16,0,0" IsEnabled="{Binding InteractionsEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{DynamicResource LOCCSM_CustomName}" Style="{StaticResource FieldLabel}" />
                                                                <TextBox Text="{Binding Profile.CustomName, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Text="{DynamicResource LOCCSM_CustomNameHelp}" Style="{StaticResource FieldHintText}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Text="{DynamicResource LOCCSM_Icon}" Style="{StaticResource FieldLabel}" />
                                                                <ComboBox ItemsSource="{Binding DataContext.IconOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding Profile.IconId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          SelectionChanged="ControllerIconSelectionChanged">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" MinHeight="28">
                                                                                <Viewbox Width="28" Height="28" Margin="0,0,8,0">
                                                                                    <Path Data="{Binding GeometryData, Converter={StaticResource IconGeometryConverter}}"
                                                                                          Fill="{Binding Foreground, ElementName=IconOptionName}"
                                                                                          Stroke="{Binding Foreground, ElementName=IconOptionName}"
                                                                                          StrokeThickness="0.45"
                                                                                          StrokeLineJoin="Round"
                                                                                          Stretch="Uniform" />
                                                                                </Viewbox>
                                                                                <TextBlock x:Name="IconOptionName" VerticalAlignment="Center">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Text" Value="{Binding Name}" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Id}" Value="default">
                                                                                                    <Setter Property="Text" Value="{DynamicResource LOCCSM_IconGeneric}" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Margin="0,16,0,0" IsEnabled="{Binding InteractionsEnabled}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Content="{DynamicResource LOCCSM_TestController}"
                                                                    Style="{StaticResource {x:Type Button}}"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="OpenTesterClick" />
                                                            <Button Grid.Column="2"
                                                                    Content="{DynamicResource LOCCSM_TestVibration}"
                                                                    Style="{StaticResource {x:Type Button}}"
                                                                    Height="34"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="VibrateControllerClick" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="EmptyControllersText" Text="{DynamicResource LOCCSM_NoControllers}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" />
                                </Grid>
                            </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem x:Name="TesterTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xE7FC;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabTester}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <tester:GamepadTesterView x:Name="TesterPane" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource TabGlyph}" Text="&#xEA18;" />
                        <TextBlock Text="{DynamicResource LOCCSM_TabSession}" Style="{StaticResource TabHeaderLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TabControl Style="{StaticResource SettingsNavigationTabControl}" Tag="{DynamicResource LOCCSM_TabSession}">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TabGlyph}" Text="&#xEA18;" />
                                <TextBlock Text="{DynamicResource LOCCSM_GamePolicySessionSection}" Style="{StaticResource TabHeaderLabel}" />
                            </StackPanel>
                        </TabItem.Header>
                        <ScrollViewer Style="{StaticResource FillScrollViewer}">
                            <StackPanel Margin="16,16,16,16">
                                <StackPanel Style="{StaticResource PageSection}">
                                    <Border Style="{StaticResource PageHeader}">
                                        <TextBlock Text="{DynamicResource LOCCSM_SessionProtectionTitle}" Style="{StaticResource SectionHeaderText}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource LOCCSM_SessionProtectionHelp}" Style="{StaticResource SectionSubtitleText}" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldGroup}">

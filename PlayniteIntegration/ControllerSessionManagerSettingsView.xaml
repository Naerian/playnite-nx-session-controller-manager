<UserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerSessionManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="920">
    <UserControl.Resources>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style x:Key="IntroCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="MinHeight" Value="104" />
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="TopTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,3" Padding="16,9,16,8">
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TopTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" Margin="0,10,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <TabControl Style="{StaticResource TopTabs}">
            <TabItem Header="{DynamicResource LOCCSM_TabOverview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCSM_Refresh}"
                                        MinWidth="120" Margin="16,0,0,0" Click="RefreshControllersClick" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCCSM_TabOverview}" Style="{StaticResource SectionHeaderText}" />
                                    <TextBlock Text="{DynamicResource LOCCSM_OverviewHelp}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock x:Name="ConnectedCountText" Style="{StaticResource SummaryValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_XInputProvider}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock x:Name="XInputStatusText" Style="{StaticResource SummaryValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_PrimaryController}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock x:Name="PrimaryControllerText" Style="{StaticResource SummaryValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_LastRefresh}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock x:Name="LastRefreshText" Style="{StaticResource SummaryValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabControllers}">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource IntroCard}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCSM_Refresh}"
                                    MinWidth="120" Margin="16,0,0,0" Click="RefreshControllersClick" />
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_ControllersHelp}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <ListView x:Name="ControllerList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource LOCCSM_ControllerName}" DisplayMemberBinding="{Binding Name}" Width="230" />
                                    <GridViewColumn Header="{DynamicResource LOCCSM_Provider}" DisplayMemberBinding="{Binding Provider}" Width="90" />
                                    <GridViewColumn Header="{DynamicResource LOCCSM_Connection}" DisplayMemberBinding="{Binding Connection}" Width="110" />
                                    <GridViewColumn Header="{DynamicResource LOCCSM_Battery}" DisplayMemberBinding="{Binding Battery}" Width="100" />
                                    <GridViewColumn Header="{DynamicResource LOCCSM_LastInput}" DisplayMemberBinding="{Binding LastInput}" Width="170" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="EmptyControllersText" Text="{DynamicResource LOCCSM_NoControllers}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_TabGeneral}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_GeneralHelp}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource LOCCSM_EnableMonitoring}" IsChecked="{Binding EnableMonitoring}" Margin="0,0,0,12" />
                                <TextBlock Text="{DynamicResource LOCCSM_ReconciliationInterval}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_ReconciliationHelp}" Style="{StaticResource HintText}" Margin="0,5,0,8" />
                                <DockPanel LastChildFill="False">
                                    <TextBox Width="72" Text="{Binding ReconciliationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{DynamicResource LOCCSM_Seconds}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabAdvanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_TabAdvanced}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_AdvancedHelp}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_DiagnosticsTitle}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,10" />
                                <CheckBox Content="{DynamicResource LOCCSM_EnableDebugLogging}" IsChecked="{Binding EnableDebugLogging}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_FoundationTitle}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_FoundationNotice}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <StackPanel>
                                <TextBlock Text="Controller Session Manager" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource LOCCSM_Version011}" Opacity="0.72" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_AboutPurpose}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutDescription}" Style="{StaticResource HintText}" Margin="0,7,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

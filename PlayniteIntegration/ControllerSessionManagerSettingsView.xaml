        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="52" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource Narian.Surface}" />
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <Grid Margin="16,8,8,8" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  HorizontalAlignment="Stretch"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock x:Name="ExpanderHint" Grid.Row="1"
                                                           Text="{DynamicResource LOCCSM_ExpandSectionHint}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,8,0,0" />
                                            </Grid>
                                        </ToggleButton>
                                        <Button x:Name="ExpanderChevron" Grid.Column="1"
                                                Style="{StaticResource ExpanderChevronButton}"
                                                VerticalAlignment="Center"
                                                Click="ExpanderChevronButton_OnClick">
                                            <Path x:Name="ExpanderArrow"
                                                  Width="12" Height="7"
                                                  Stretch="Uniform"
                                                  Data="M0,0 L6,6 L12,0"
                                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,16,8,16"
                                    TextElement.Foreground="{DynamicResource TextBrush}"
                                    TextElement.FontSize="14">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource Narian.Hover}" />
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource Narian.Accent}" />
                                <Setter TargetName="ExpanderHint" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ExpanderArrow" Property="Data" Value="M0,6 L6,0 L12,6" />
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact nested expanders for Layout/Content/Shape/Colors (no hint row). -->
        <Style x:Key="AppearanceSectionExpander" TargetType="Expander" BasedOn="{StaticResource SettingsExpander}">

<UserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerSessionManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControllerSessionManager.PlayniteIntegration"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinWidth="980" MinHeight="640" d:DesignHeight="780" d:DesignWidth="1100">
    <UserControl.Resources>
        <local:IconGeometryConverter x:Key="IconGeometryConverter" />
        <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <local:PreviewScaleConverter x:Key="PreviewScaleConverter" />
        <local:NumberToThicknessConverter x:Key="NumberToThicknessConverter" />
        <local:NumberToCornerRadiusConverter x:Key="NumberToCornerRadiusConverter" />
        <local:OptionalBorderThicknessConverter x:Key="OptionalBorderThicknessConverter" />
        <Style x:Key="ColorPickerButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCCSM_SelectColor}" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SliderRangeText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="AppearanceGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style x:Key="AppearanceGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="ControllerCard" TargetType="Border" BasedOn="{StaticResource IntroCard}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="CompactSliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,10" />
        </Style>
        <Style x:Key="CompactChoicePanel" TargetType="StackPanel">
            <Setter Property="Width" Value="205" />
            <Setter Property="Margin" Value="0,0,16,10" />
        </Style>
        <Style x:Key="CompactColorPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="0,0,14,10" />
        </Style>
        <Style x:Key="IntroCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,9" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ControllerTableBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ControllerTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ControllerTableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="AlternationIndex" Value="1" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTable" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ControllerTableHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource ControllerTableCell}" />
            <Setter Property="RowStyle" Value="{StaticResource ControllerTableRow}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="Cell" />
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="NavigationItemBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,3,0" Padding="16,12,18,12">
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="228" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="0,0,1,0"
                                    Padding="4,8,10,8">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="2"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="0,0,0,3" Padding="20,12,20,11">
                            <ContentPresenter x:Name="Header" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
                                <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TopTabs" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource TopTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="0,0,0,1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" Margin="0,10,0,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14">
        <TabControl Style="{StaticResource TopTabs}">
            <TabItem Header="{DynamicResource LOCCSM_TabOverview}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCSM_Refresh}"
                                        MinWidth="120" Margin="16,0,0,0" Click="RefreshControllersClick" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCCSM_TabOverview}" Style="{StaticResource SectionHeaderText}" />
                                    <TextBlock Text="{DynamicResource LOCCSM_OverviewHelp}" Style="{StaticResource SectionSubtitleText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="ConnectedCountText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_SessionStatus}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="SessionStatusText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_XInputProvider}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="XInputStatusText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_PrimaryController}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="PrimaryControllerText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_LastRefresh}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="LastRefreshText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCard}" BorderBrush="{DynamicResource HighlightGlyphBrush}" BorderThickness="4,1,1,1">
                                    <StackPanel Margin="14,12">
                                        <Border Style="{StaticResource SummaryTitleSeparator}">
                                            <TextBlock Text="{DynamicResource LOCCSM_ActiveSessionControllers}" Style="{StaticResource SummaryCardTitle}" />
                                        </Border>
                                        <TextBlock x:Name="ActiveSessionControllersText" Style="{StaticResource SummaryCardValue}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabControllers}">
                <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource IntroCard}" Margin="0,0,0,8">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="{DynamicResource LOCCSM_Refresh}"
                                            MinWidth="120" Margin="16,0,0,0" VerticalAlignment="Center"
                                            Click="RefreshControllersClick" />
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_ConnectedControllers}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock Text="{DynamicResource LOCCSM_ControllersHelp}" Style="{StaticResource SectionSubtitleText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBlock Style="{StaticResource NoteText}" Margin="4,0,4,12">
                                <Run FontWeight="SemiBold" Text="{DynamicResource LOCCSM_NotePrefix}" />
                                <Run Text=" " />
                                <Run Text="{DynamicResource LOCCSM_BatteryUnknownHint}" />
                            </TextBlock>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid MinHeight="120">
                                        <ItemsControl x:Name="ControllerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ControllerCard}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="56" Height="56" Margin="0,0,16,0"
                                                                    VerticalAlignment="Top"
                                                                    Background="{DynamicResource ControlBackgroundBrush}"
                                                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                <Viewbox Width="32" Height="32">
                                                                    <Path Data="{Binding IconGeometry, Converter={StaticResource IconGeometryConverter}}"
                                                                          Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          StrokeLineJoin="Round" Stretch="Uniform" />
                                                                </Viewbox>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding DetectedName}" Style="{StaticResource SectionHeaderText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                                                    <Grid ToolTip="{Binding Connection}" Margin="0,0,14,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                                                                <Path Data="{Binding ConnectionIconGeometry, Converter={StaticResource IconGeometryConverter}}"
                                                                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="2"
                                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                                      StrokeLineJoin="Round" Stretch="Uniform" />
                                                                            </Viewbox>
                                                                            <TextBlock Text="{Binding Connection}" VerticalAlignment="Center"
                                                                                       Style="{StaticResource HintText}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                                                        <Ellipse Width="8" Height="8" Fill="{Binding BatteryBrush}" Margin="0,0,6,0"
                                                                                 VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Battery}" Foreground="{Binding BatteryBrush}"
                                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Provider}" Style="{StaticResource HintText}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="16" />
                                                                        <ColumnDefinition Width="220" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{DynamicResource LOCCSM_UserName}" Style="{StaticResource FieldLabel}" />
                                                                        <TextBox Text="{Binding Profile.CustomName, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2">
                                                                        <TextBlock Text="{DynamicResource LOCCSM_Icon}" Style="{StaticResource FieldLabel}" />
                                                                        <ComboBox ItemsSource="{Binding DataContext.IconOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  SelectedValuePath="Id"
                                                                                  SelectedValue="{Binding Profile.IconId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  SelectionChanged="ControllerIconSelectionChanged">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal" MinHeight="22">
                                                                                        <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                                                                                            <Path Data="{Binding GeometryData, Converter={StaticResource IconGeometryConverter}}"
                                                                                                  Stroke="Gray" StrokeThickness="2" Fill="Transparent"
                                                                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                                                                  StrokeEndLineCap="Round" Stretch="Uniform" />
                                                                                        </Viewbox>
                                                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                        </ComboBox>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="EmptyControllersText" Text="{DynamicResource LOCCSM_NoControllers}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabSession}">
                <TabControl Style="{StaticResource SettingsNavigationTabControl}">
                    <TabItem Header="{DynamicResource LOCCSM_GamePolicySessionSection}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8">
                                <Border Style="{StaticResource IntroCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_SessionProtectionTitle}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock Text="{DynamicResource LOCCSM_AdaptiveProtectionHelp}" Style="{StaticResource SectionSubtitleText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox Content="{DynamicResource LOCCSM_EnableSessionTracking}" IsChecked="{Binding EnableSessionTracking}" />

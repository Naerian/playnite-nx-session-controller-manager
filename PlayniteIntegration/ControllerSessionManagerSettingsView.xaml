                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayPadding}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayPadding}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="12" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding OverlayPadding, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="12–80" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayCornerRadius}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayCornerRadius}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayCornerRadius, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="0–40" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                            </WrapPanel></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceGroup}">
                                            <StackPanel><TextBlock Text="{DynamicResource LOCCSM_AppearanceTypography}" Style="{StaticResource AppearanceGroupHeader}"/><WrapPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayTitleSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayTitleFontSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="18" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayTitleFontSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="18–64" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayControllerTextSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayControllerFontSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="12" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayControllerFontSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="12–48" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayInstructionSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayInstructionFontSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="12" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayInstructionFontSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="12–40" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayStatusSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayStatusFontSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="10" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayStatusFontSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="10–30" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                            </WrapPanel></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceGroup}">
                                            <StackPanel><TextBlock Text="{DynamicResource LOCCSM_AppearanceIconsBorder}" Style="{StaticResource AppearanceGroupHeader}"/><WrapPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}" IsEnabled="{Binding OverlayShowControllerIcon}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayControllerIconSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayControllerIconSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="16" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding OverlayControllerIconSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="16–72" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                                <StackPanel Style="{StaticResource CompactSliderPanel}" IsEnabled="{Binding OverlayShowStatusIcon}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_OverlayStatusIconSize}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayStatusIconSize}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="12" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayStatusIconSize, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="12–48" Style="{StaticResource SliderRangeText}"/></StackPanel>
                                            </WrapPanel><WrapPanel Margin="0,2,0,10"><CheckBox Content="{DynamicResource LOCCSM_OverlayShowControllerIcon}" IsChecked="{Binding OverlayShowControllerIcon}" Margin="0,0,18,0"/><CheckBox Content="{DynamicResource LOCCSM_OverlayShowStatusIcon}" IsChecked="{Binding OverlayShowStatusIcon}"/></WrapPanel><CheckBox Content="{DynamicResource LOCCSM_OverlayShowBorder}" IsChecked="{Binding OverlayShowBorder}" Margin="0,2,0,10"/><WrapPanel><StackPanel Style="{StaticResource CompactSliderPanel}" IsEnabled="{Binding OverlayShowBorder}"><DockPanel><TextBlock Text="{DynamicResource LOCCSM_NotificationBorderThickness}"/><TextBlock DockPanel.Dock="Right" Text="{Binding OverlayBorderThickness}" Style="{StaticResource SliderValueText}"/></DockPanel><Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding OverlayBorderThickness, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="0–10" Style="{StaticResource SliderRangeText}"/></StackPanel></WrapPanel></StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource AppearanceGroup}">
                                            <StackPanel><TextBlock Text="{DynamicResource LOCCSM_AppearanceColors}" Style="{StaticResource AppearanceGroupHeader}"/><TextBlock Text="{DynamicResource LOCCSM_ColorFormatHelp}" Style="{StaticResource HintText}" Margin="0,0,0,6"/><TextBlock Text="{DynamicResource LOCCSM_BackdropHelp}" Style="{StaticResource HintText}" Margin="0,0,0,10"/><WrapPanel>
                                                <StackPanel Style="{StaticResource CompactColorPanel}"><TextBlock Text="{DynamicResource LOCCSM_DimColor}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="OverlayDimColor" Click="SelectColorClick"><Border Width="18" Height="18" Background="{Binding OverlayDimColor, Converter={StaticResource HexColorBrushConverter}}"/></Button><TextBox Text="{Binding OverlayDimColor, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                                                <StackPanel Style="{StaticResource CompactColorPanel}"><TextBlock Text="{DynamicResource LOCCSM_CardColor}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="OverlayCardColor" Click="SelectColorClick"><Border Width="18" Height="18" Background="{Binding OverlayCardColor, Converter={StaticResource HexColorBrushConverter}}"/></Button><TextBox Text="{Binding OverlayCardColor, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                                                <StackPanel Style="{StaticResource CompactColorPanel}"><TextBlock Text="{DynamicResource LOCCSM_AccentColor}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="OverlayAccentColor" Click="SelectColorClick"><Border Width="18" Height="18" Background="{Binding OverlayAccentColor, Converter={StaticResource HexColorBrushConverter}}"/></Button><TextBox Text="{Binding OverlayAccentColor, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                                                <StackPanel Style="{StaticResource CompactColorPanel}"><TextBlock Text="{DynamicResource LOCCSM_PrimaryTextColor}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="OverlayTextColor" Click="SelectColorClick"><Border Width="18" Height="18" Background="{Binding OverlayTextColor, Converter={StaticResource HexColorBrushConverter}}"/></Button><TextBox Text="{Binding OverlayTextColor, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                                                <StackPanel Style="{StaticResource CompactColorPanel}"><TextBlock Text="{DynamicResource LOCCSM_WarningColor}"/><DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource ColorPickerButton}" Tag="OverlayWarningColor" Click="SelectColorClick"><Border Width="18" Height="18" Background="{Binding OverlayWarningColor, Converter={StaticResource HexColorBrushConverter}}"/></Button><TextBox Text="{Binding OverlayWarningColor, UpdateSourceTrigger=PropertyChanged}"/></DockPanel></StackPanel>
                                            </WrapPanel></StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource LOCCSM_OverlayPreview}" Style="{StaticResource SectionHeaderText}" Margin="0,4,0,8"/>
                                        <Border Height="320" Background="{Binding OverlayDimColor, Converter={StaticResource HexColorBrushConverter}}" CornerRadius="8" ClipToBounds="True">
                                            <Grid>
                                                <Border Width="510" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Margin="20,34"
                                                        RenderTransformOrigin="0.5,0.5" RenderTransform="{Binding OverlayScalePercent, Converter={StaticResource PreviewScaleConverter}}"
                                                        Background="{Binding OverlayCardColor, Converter={StaticResource HexColorBrushConverter}}"
                                                        BorderBrush="{Binding OverlayAccentColor, Converter={StaticResource HexColorBrushConverter}}"
                                                        Padding="{Binding OverlayPadding, Converter={StaticResource NumberToThicknessConverter}}"
                                                        CornerRadius="{Binding OverlayCornerRadius, Converter={StaticResource NumberToCornerRadiusConverter}}">
                                                    <Border.BorderThickness><MultiBinding Converter="{StaticResource OptionalBorderThicknessConverter}"><Binding Path="OverlayShowBorder"/><Binding Path="OverlayBorderThickness"/></MultiBinding></Border.BorderThickness>
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource LOCCSM_OverlayDisconnectTitle}" Foreground="{Binding OverlayTextColor, Converter={StaticResource HexColorBrushConverter}}" FontWeight="SemiBold" FontSize="{Binding OverlayTitleFontSize}" HorizontalAlignment="Center"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,13,0,0">
                                                            <Path x:Name="OverlayPreviewControllerIcon" Width="{Binding OverlayControllerIconSize}" Height="{Binding OverlayControllerIconSize}" Stretch="Uniform" Stroke="{Binding OverlayTextColor, Converter={StaticResource HexColorBrushConverter}}" StrokeThickness="2" Margin="0,0,9,0"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding OverlayShowControllerIcon}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                                                            <TextBlock Text="{DynamicResource LOCCSM_PreviewControllerName}" Foreground="{Binding OverlayTextColor, Converter={StaticResource HexColorBrushConverter}}" FontSize="{Binding OverlayControllerFontSize}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{DynamicResource LOCCSM_OverlayAllowTakeover}" Foreground="{Binding OverlayAccentColor, Converter={StaticResource HexColorBrushConverter}}" FontSize="{Binding OverlayInstructionFontSize}" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                                                        <Border Background="#302391FF" CornerRadius="5" Padding="9,5" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                            <StackPanel Orientation="Horizontal"><Path x:Name="OverlayPreviewStatusIcon" Width="{Binding OverlayStatusIconSize}" Height="{Binding OverlayStatusIconSize}" Stretch="Uniform" Stroke="{Binding OverlayWarningColor, Converter={StaticResource HexColorBrushConverter}}" StrokeThickness="2" Margin="0,0,7,0"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding OverlayShowStatusIcon}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{DynamicResource LOCCSM_OverlayForcePaused}" Foreground="{Binding OverlayWarningColor, Converter={StaticResource HexColorBrushConverter}}" FontSize="{Binding OverlayStatusFontSize}"/></StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{DynamicResource LOCCSM_OverlayPreviewHelp}" Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabAdvanced}">
                <TabControl Style="{StaticResource SettingsNavigationTabControl}">
                    <TabItem Header="{DynamicResource LOCCSM_Monitoring}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8">
                                <Border Style="{StaticResource IntroCard}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LOCCSM_Monitoring}" Style="{StaticResource SectionHeaderText}" />
                                        <TextBlock Text="{DynamicResource LOCCSM_GeneralHelp}" Style="{StaticResource SectionSubtitleText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox Content="{DynamicResource LOCCSM_ReconciliationInterval}" IsChecked="{Binding EnableMonitoring}" />
                                        <TextBlock Text="{DynamicResource LOCCSM_ReconciliationHelp}" Style="{StaticResource HintText}" Margin="22,6,0,8" />
                                        <DockPanel LastChildFill="False" Margin="22,0,0,0" IsEnabled="{Binding EnableMonitoring}">
                                            <TextBox Width="72" Text="{Binding ReconciliationIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{DynamicResource LOCCSM_Seconds}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource LOCCSM_DiagnosticsTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_DiagnosticsTitle}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_AdvancedHelp}" Style="{StaticResource SectionSubtitleText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource LOCCSM_EnableDebugLogging}" IsChecked="{Binding EnableDebugLogging}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_SupportReport}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_SupportReportHelp}" Style="{StaticResource HintText}" Margin="0,6,0,12" />
                                <Button Content="{DynamicResource LOCCSM_ExportSupportReport}" HorizontalAlignment="Left"
                                        MinWidth="180" Click="ExportSupportReportClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_HidDiagnostics}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_HidDiagnosticsHelp}" Style="{StaticResource HintText}" Margin="0,6,0,12" />
                                <Button Content="{DynamicResource LOCCSM_ExportHidDiagnostics}" HorizontalAlignment="Left"
                                        MinWidth="180" Click="ExportHidDiagnosticsClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_FoundationTitle}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_FoundationNotice}" Style="{StaticResource SectionSubtitleText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="{DynamicResource LOCCSM_TabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <Border Style="{StaticResource IntroCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_AboutDescription}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock x:Name="AboutVersionText" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LOCCSM_AboutWhatItDoesTitle}" Style="{StaticResource SectionHeaderText}" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities2}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities3}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock Text="{DynamicResource LOCCSM_AboutCapabilities4}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCCSM_ProjectLinksTitle}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />
                                    <WrapPanel>
                                        <Button Content="GitHub" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager"
                                                MinWidth="100" Margin="0,0,8,8" Click="OpenExternalButton" />
                                        <Button Content="{DynamicResource LOCCSM_OpenWiki}" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager/wiki"
                                                MinWidth="100" Margin="0,0,8,8" Click="OpenExternalButton" />
                                        <Button Content="{DynamicResource LOCCSM_ReportIssue}" Tag="https://github.com/Naerian/playnite-nx-session-controller-manager/issues/new"
                                                MinWidth="140" Margin="0,0,0,8" Click="OpenExternalButton" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LOCCSM_SupportTitle}" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,10" />
                                    <TextBlock Text="{DynamicResource LOCCSM_KoFiSupportHelp}" Style="{StaticResource HintText}" Margin="0,0,0,14" />
                                    <Button Content="{DynamicResource LOCCSM_KoFiSupport}" Tag="https://ko-fi.com/naerian"
                                            HorizontalAlignment="Left" MinWidth="150" Padding="16,7" Click="OpenExternalButton" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

<UserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerSessionManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControllerSessionManager.PlayniteIntegration"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinWidth="980" MinHeight="640" d:DesignHeight="780" d:DesignWidth="1100"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontSize="14">
    <UserControl.Resources>
        <local:IconGeometryConverter x:Key="IconGeometryConverter" />
        <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <local:PreviewScaleConverter x:Key="PreviewScaleConverter" />
        <local:NumberToThicknessConverter x:Key="NumberToThicknessConverter" />
        <local:NumberToCornerRadiusConverter x:Key="NumberToCornerRadiusConverter" />
        <local:OptionalBorderThicknessConverter x:Key="OptionalBorderThicknessConverter" />
        <Style x:Key="SettingsToggleTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCCSM_SelectColor}" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="PageHeader" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style x:Key="ControlHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="22,8,0,16" />
        </Style>
        <Style x:Key="ControlHintTextLast" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="22,8,0,0" />
        </Style>
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SliderRangeText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="AppearanceGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="OverlayAppearanceGroup" TargetType="Border" BasedOn="{StaticResource AppearanceGroup}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="AppearanceGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OverlayAppearanceGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource AppearanceGroupHeader}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PageSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ControllerCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Padding" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightGlyphBrush}" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextElement.FontSize" Value="12" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="CapabilityPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style x:Key="CompactSliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlaySliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="232" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="CompactChoicePanel" TargetType="StackPanel">
            <Setter Property="Width" Value="205" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="StackedColorPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlayColorPanel" TargetType="StackPanel" BasedOn="{StaticResource StackedColorPanel}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ControllerTableBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ControllerTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ControllerTableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetailsViewBannerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="AlternationIndex" Value="1" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTable" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ControllerTableHeader}" />
            <Setter Property="CellStyle" Value="{StaticResource ControllerTableCell}" />
            <Setter Property="RowStyle" Value="{StaticResource ControllerTableRow}" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="Cell" />
        </Style>
        <Style x:Key="TabGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="TabHeaderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PreviewActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PreviewButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PreviewButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PreviewButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExpanderHeaderButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="HeaderChrome" DockPanel.Dock="Top" MinHeight="52" ClipToBounds="False"
                                    Cursor="Hand">
                                <Grid ClipToBounds="False">
                                    <Rectangle x:Name="ExpanderFill" RadiusX="4" RadiusY="4"
                                               Fill="{DynamicResource ControlBackgroundBrush}" />
                                    <Rectangle x:Name="ExpanderAccent" Width="4" HorizontalAlignment="Left"
                                               RadiusX="4" RadiusY="4" Fill="Transparent" />
                                    <ToggleButton Style="{StaticResource ExpanderHeaderButton}"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="16,10,8,10" VerticalAlignment="Center">
                                                <ContentPresenter x:Name="ExpanderHeader" ContentSource="Header"
                                                                  RecognizesAccessKey="True"
                                                                  TextElement.Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock x:Name="ExpanderHint"
                                                           Text="{DynamicResource LOCCSM_ExpandSectionHint}"
                                                           Style="{StaticResource HintText}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                            <Border x:Name="ExpanderChevron" Grid.Column="1" Width="32" Height="32"
                                                    CornerRadius="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                    BorderBrush="{DynamicResource GlyphBrush}" BorderThickness="1">
                                                <TextBlock x:Name="ExpanderArrow"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Text="&#xE70D;" FontSize="14"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Border x:Name="ExpanderContent" Visibility="Collapsed" Padding="16,14,8,12"
                                    TextElement.Foreground="{DynamicResource TextBrush}">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderChrome" Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpanderFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="ExpanderAccent" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="ExpanderHint" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="ExpanderArrow" Property="Text" Value="&#xE70E;" />
                                <Setter TargetName="ExpanderHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabItem" TargetType="TabItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid ClipToBounds="False">
                            <Rectangle x:Name="NavigationFill" RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <Rectangle x:Name="NavigationAccent" Width="4" HorizontalAlignment="Left"
                                       RadiusX="4" RadiusY="4" Fill="Transparent" />
                            <ContentPresenter x:Name="NavigationHeader" ContentSource="Header"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="16,12,16,12"
                                              TextElement.Foreground="{DynamicResource TextBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationFill" Property="Fill" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="NavigationAccent" Property="Fill" Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="NavigationHeader" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsNavigationTabControl" TargetType="TabControl">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavigationTabItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="268" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource PopupBackgroundBrush}" CornerRadius="4"
                                    Padding="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Tag}"
                                               Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold"
                                               Margin="8,4,8,16" TextWrapping="Wrap" />
                                    <StackPanel x:Name="HeaderPanel" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="2">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </Grid>
                        </Grid>

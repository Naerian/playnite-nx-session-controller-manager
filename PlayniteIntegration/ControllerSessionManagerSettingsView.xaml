<UserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerSessionManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ControllerSessionManager.PlayniteIntegration"
             xmlns:tester="clr-namespace:ControllerSessionManager.Tester.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" MinWidth="980" MinHeight="640" d:DesignHeight="780" d:DesignWidth="1100"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             Background="{DynamicResource Narian.Bg}"
             TextElement.Foreground="{DynamicResource TextBrush}"
             TextElement.FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <local:IconGeometryConverter x:Key="IconGeometryConverter" />
        <local:HexColorBrushConverter x:Key="HexColorBrushConverter" />
        <local:PreviewScaleConverter x:Key="PreviewScaleConverter" />
        <local:NotificationFontFamilyConverter x:Key="NotificationFontFamilyConverter" />
        <local:NotificationFontWeightConverter x:Key="NotificationFontWeightConverter" />
        <local:NotificationFontDisplayNameConverter x:Key="NotificationFontDisplayNameConverter" />
        <local:NotificationTypefaceFamilyConverter x:Key="NotificationTypefaceFamilyConverter" />
        <local:NotificationTypefaceWeightConverter x:Key="NotificationTypefaceWeightConverter" />
        <local:BatteryBadgeBrushConverter x:Key="BatteryBadgeBrushConverter" />
        <local:OptionalGradientBrushConverter x:Key="OptionalGradientBrushConverter" />
        <local:OptionalBorderGradientBrushConverter x:Key="OptionalBorderGradientBrushConverter" />
        <local:OptionalBorderGlowEffectConverter x:Key="OptionalBorderGlowEffectConverter" />
        <local:OptionalImageBrushConverter x:Key="OptionalImageBrushConverter" />
        <local:OptionalTintBrushConverter x:Key="OptionalTintBrushConverter" />
        <local:OptionalColorBrushConverter x:Key="OptionalColorBrushConverter" />
        <Style x:Key="AppearancePresetItemStyle" TargetType="ComboBoxItem"
               BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Narian.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="PresetItemBackground"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="PresetItemBackground" Property="Background" Value="{DynamicResource Narian.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PresetItemBackground" Property="Background" Value="{DynamicResource Narian.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Margin" Value="0,8,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="AppearancePresetItemTemplate">
            <Border x:Name="PresetRow" Padding="7,3" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PresetLabel" Text="{Binding DisplayName}" VerticalAlignment="Center"
                               Foreground="{DynamicResource Narian.Text}" />
                    <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                            Width="28" Height="24" MinWidth="28" MinHeight="24" Padding="0"
                            Margin="16,0,0,0" Tag="{Binding Key}" Click="DeleteImportedVisualProfileClick"
                            ToolTip="{DynamicResource LOCCSM_DeleteImportedDesign}"
                            Visibility="{Binding IsImported, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}"
                             Value="True">
                    <Setter TargetName="PresetLabel" Property="Foreground" Value="{DynamicResource Narian.AccentOn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="PresetRow" Property="BorderBrush" Value="{DynamicResource Narian.Accent}" />
                    <Setter TargetName="PresetRow" Property="BorderThickness" Value="0,0,0,1" />
                    <Setter TargetName="PresetRow" Property="Padding" Value="7,3,7,6" />
                    <Setter TargetName="PresetLabel" Property="Foreground" Value="{DynamicResource Narian.Accent}" />
                    <Setter TargetName="PresetLabel" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="OverlayFontFamilySelector" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemsSource" Value="{x:Static local:NotificationFontCatalog.NamedFonts}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource NotificationFontDisplayNameConverter}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <local:NumberToThicknessConverter x:Key="NumberToThicknessConverter" />
        <local:NumberToCornerRadiusConverter x:Key="NumberToCornerRadiusConverter" />
        <local:OptionalBorderThicknessConverter x:Key="OptionalBorderThicknessConverter" />
        <local:OverlayPositionHorizontalAlignmentConverter x:Key="OverlayPositionHorizontalAlignmentConverter" />
        <local:OverlayPositionVerticalAlignmentConverter x:Key="OverlayPositionVerticalAlignmentConverter" />
        <local:TextAlignmentConverter x:Key="TextAlignmentConverter" />
        <local:StringEqualsConverter x:Key="StringEqualsConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="NarianPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Narian.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Narian.AccentOn}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Narian.AccentHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Narian.AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsToggleTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{DynamicResource LOCCSM_SelectColor}" />
        </Style>
        <Style x:Key="SectionHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="PageHeader" TargetType="Border" BasedOn="{StaticResource SectionHeaderBorder}" />
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontStyle" Value="Normal" />
        </Style>
        <Style x:Key="SectionSubtitleText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="WarningHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Foreground" Value="#FFE24B4B" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style x:Key="ControlHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="ControlHintTextLast" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FieldHintText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="Margin" Value="0,8,0,16" />
        </Style>
        <Style x:Key="ReadOnlyPathInput" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="IconSquareButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MaxWidth" Value="32" />
            <Setter Property="MaxHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- Transparent square used by expander chevrons; theme Button padding offsets Path otherwise. -->
        <Style x:Key="ExpanderChevronButton" TargetType="Button" BasedOn="{StaticResource IconSquareButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SliderRangeText" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="AppearanceGroup" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="OverlayAppearanceGroup" TargetType="Border" BasedOn="{StaticResource AppearanceGroup}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="AppearanceGroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="OverlayAppearanceGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource AppearanceGroupHeader}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FillScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="PageSection" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,24" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Flat section wrapper: forms sit on page bg (MetaDataIA / Audio Switcher). -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ElevatedCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="InfoCallout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="InfoCalloutAccentBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Background" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="InfoCalloutTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="InfoCalloutBody" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
        <Style x:Key="InfoCalloutGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,10,0" />
        </Style>
        <Style x:Key="WarningCallout" TargetType="Border" BasedOn="{StaticResource InfoCallout}">
            <Setter Property="Background" Value="#20F5B542" />
            <Setter Property="BorderBrush" Value="#80F5B542" />
        </Style>
        <Style x:Key="WarningCalloutAccentBar" TargetType="Border" BasedOn="{StaticResource InfoCalloutAccentBar}">
            <Setter Property="Background" Value="#FFF5B542" />
        </Style>
        <Style x:Key="WarningCalloutGlyph" TargetType="TextBlock" BasedOn="{StaticResource InfoCalloutGlyph}">
            <Setter Property="Foreground" Value="#FFF5B542" />
        </Style>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="92" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="ControllerCard" TargetType="Border" BasedOn="{StaticResource SummaryCard}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="SummaryPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.BadgeBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="CapabilityPill" TargetType="Border" BasedOn="{StaticResource SummaryPill}">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Opacity" Value="0.92" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="CompactSliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlaySliderPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="CompactChoicePanel" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="StackedColorPanel" TargetType="StackPanel">
            <Setter Property="Width" Value="220" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Resources>
                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}" />
            </Style.Resources>
        </Style>
        <Style x:Key="OverlayColorPanel" TargetType="StackPanel" BasedOn="{StaticResource StackedColorPanel}" />
        <Style x:Key="SummaryCardTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{DynamicResource Narian.Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SummaryTitleSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SummaryCardValue" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="ControllerTableBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Narian.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="ControllerTableHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Narian.TableHeader}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="ControllerTableCell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Narian.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ControllerTableRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Narian.RowOdd}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"

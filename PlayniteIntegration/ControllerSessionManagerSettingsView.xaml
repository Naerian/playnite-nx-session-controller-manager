                                                                            <TextBlock Text="{Binding Connection}" Foreground="{Binding ConnectionBrush}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border Style="{StaticResource CapabilityPill}"
                                                                            Margin="0,0,8,8"

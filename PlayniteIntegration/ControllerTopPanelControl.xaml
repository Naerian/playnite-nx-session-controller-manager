<playnite:PluginUserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerTopPanelControl"
                            x:Name="Root"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            HorizontalContentAlignment="Center"
                            Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                ToolTip="{Binding PrimaryControllerTooltip}">
        <Viewbox Width="20" Height="20">
            <Viewbox.Style>
                <Style TargetType="Viewbox">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Margin" Value="2,0,5,0" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasPrimaryControllerBattery}" Value="True" />
                                <Condition Binding="{Binding IsCompactTopPanelLayout, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Margin" Value="2,0" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Viewbox.Style>
            <Path Data="{Binding PrimaryControllerIconGeometry}" Stretch="Uniform"
                  StrokeThickness="2"
                  Fill="Transparent"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Stroke" Value="{Binding Foreground, ElementName=Root}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsePrimaryControllerBatteryColor}" Value="True">
                                <Setter Property="Stroke" Value="{Binding PrimaryControllerBatteryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Viewbox>
        <TextBlock Text="{Binding PrimaryControllerBatteryLabel}"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,2,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Foreground" Value="{Binding Foreground, ElementName=Root}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UsePrimaryControllerBatteryColor}" Value="True">
                            <Setter Property="Foreground" Value="{Binding PrimaryControllerBatteryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasPrimaryControllerBattery}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasPrimaryControllerBattery}" Value="True" />
                                <Condition Binding="{Binding IsCompactTopPanelLayout, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</playnite:PluginUserControl>

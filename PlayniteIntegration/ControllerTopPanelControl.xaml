<playnite:PluginUserControl x:Class="ControllerSessionManager.PlayniteIntegration.ControllerTopPanelControl"
                            x:Name="Root"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="clr-namespace:ControllerSessionManager.PlayniteIntegration"
                            xmlns:playnite="clr-namespace:Playnite.SDK.Controls;assembly=Playnite.SDK"
                            HorizontalContentAlignment="Center"
                            Focusable="False">
    <playnite:PluginUserControl.Resources>
        <local:IconGeometryConverter x:Key="IconGeometryConverter" />
    </playnite:PluginUserControl.Resources>
    <Viewbox Width="20" Height="20" Margin="2,0"
             VerticalAlignment="Center" HorizontalAlignment="Center"
             ToolTip="{Binding PrimaryControllerTooltip}">
        <Path Data="{Binding PrimaryControllerIconGeometry, Converter={StaticResource IconGeometryConverter}}" Stretch="Uniform"
              StrokeThickness="2"
              Fill="Transparent"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round">
            <Path.Style>
                <Style TargetType="Path">
                    <Setter Property="Stroke" Value="{Binding Foreground, ElementName=Root}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UsePrimaryControllerBatteryColor}" Value="True">
                            <Setter Property="Stroke" Value="{Binding PrimaryControllerBatteryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Path.Style>
        </Path>
    </Viewbox>
</playnite:PluginUserControl>

    <sys:String x:Key="LOCCSM_MenuDiagnostics">Controller diagnostics</sys:String>
    <sys:String x:Key="LOCCSM_MenuRefresh">Refresh controllers</sys:String>
    <sys:String x:Key="LOCCSM_DiagnosticsTitle">Controller diagnostics</sys:String>
    <sys:String x:Key="LOCCSM_DiagnosticsHeader">Controller Session Manager diagnostic snapshot</sys:String>
    <sys:String x:Key="LOCCSM_DiagnosticsCount">Connected: {0}</sys:String>
    <sys:String x:Key="LOCCSM_State">State</sys:String>
    <sys:String x:Key="LOCCSM_Provider">Provider</sys:String>
    <sys:String x:Key="LOCCSM_Connected">Connected</sys:String>
    <sys:String x:Key="LOCCSM_Disconnected">Disconnected</sys:String>
    <sys:String x:Key="LOCCSM_StatusFormat">{0} · {1} connected</sys:String>
</ResourceDictionary>


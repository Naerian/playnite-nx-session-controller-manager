    <sys:String x:Key="LOCCSM_Tester_CompatibilityAssistant">Asistente de compatibilidad</sys:String>
    <sys:String x:Key="LOCCSM_Tester_CompatibilityAssistantHelp">Comprueba el mapeo de SDL y las capacidades expuestas por el dispositivo. Las recomendaciones se basan en datos disponibles y nunca suponen un modo de entrada que SDL no pueda identificar.</sys:String>

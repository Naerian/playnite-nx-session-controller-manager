    <sys:String x:Key="LOCCSM_DesktopTabLabel">Desktop</sys:String>
    <sys:String x:Key="LOCCSM_ControllerNotificationTitle">Controller Notification</sys:String>
    <sys:String x:Key="LOCCSM_ShowControllerNameInDesktopNotifications">Show controller name in notification</sys:String>
    <sys:String x:Key="LOCCSM_BorderFull">Full</sys:String>
    <sys:String x:Key="LOCCSM_AutoPauseModeNone">Do nothing - only show the overlay if enabled</sys:String>
    <sys:String x:Key="LOCCSM_AutoPauseModeNoneHelp">The game keeps running after a disconnect. The disconnect overlay will still appear if the overlay option is enabled.</sys:String>
